# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: never commit to Git)
.env
.env.*
!.env.example
*.env
server/.env
client/.env

# Production builds
dist/
dist-ssr/
build/
*.local

# User uploads (preserve directory structure with .gitkeep)
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# AI / IDE caches
.gemini/
.agents/
