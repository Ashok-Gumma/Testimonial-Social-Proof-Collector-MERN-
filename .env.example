# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# If left blank or connection fails, the server automatically starts in-memory MongoDB (mongodb-memory-server)
MONGODB_URI=mongodb://localhost:27017/testimonial_collector

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_testimonial_2026_spec
JWT_REFRESH_SECRET=super_secret_refresh_key_testimonial_2026_spec
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
