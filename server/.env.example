# Server Environment Template (Copy to .env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# e.g., mongodb://localhost:27017/testimonial_collector or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/testimonial_collector

# JWT Secrets (generate strong random secrets for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
